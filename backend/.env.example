DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=proofly_db
POSTGRES_USER=proofly
POSTGRES_PASSWORD=proofly
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000

# OpenAI Responses API. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=1200
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_TEXT_CHARS=40000
AI_MAX_IMAGE_BYTES=8388608
FRONTEND_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=noreply@proofly.local
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
